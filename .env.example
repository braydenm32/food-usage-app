# Supabase: accounts, household sharing and sync. Public values, safe in the browser
# (data is protected by row-level security). Leave both empty for a local-only Larder.
NEXT_PUBLIC_SUPABASE_URL=https://lnfqgkpindoglgkqybqg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EG36v7QdT22jiR1DZlBnug_6SbIoh0_

# Server only: enables receipt/list photo reading and AI recipes
ANTHROPIC_API_KEY=
# LARDER_AI_MODEL=claude-haiku-5-5

# Server only: TheMealDB supporter key for production (the shared test key "1" is used when empty)
THEMEALDB_API_KEY=

# Background reminders (Web Push). Generate a key pair with `npx web-push generate-vapid-keys`.
# The public key is safe in the browser; the private key is server only. Leave empty to
# keep reminders in-app only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services if something goes wrong: mailto:you@example.com or your site's URL.
VAPID_SUBJECT=
# Server only: lets the reminder sender read every household's food. Supabase dashboard →
# Project Settings → API keys → service_role (or a secret key). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: any long random string. Vercel Cron sends it to /api/push/send automatically.
CRON_SECRET=
