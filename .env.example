# Supabase: accounts, household sharing and sync. Public values, safe in the browser
# (data is protected by row-level security). Leave both empty for a local-only Larder.
NEXT_PUBLIC_SUPABASE_URL=https://lnfqgkpindoglgkqybqg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EG36v7QdT22jiR1DZlBnug_6SbIoh0_

# Server only: enables receipt/list photo reading and AI recipes. AI features are for signed-in
# people only, so they ALSO need NEXT_PUBLIC_SUPABASE_URL (above) and SUPABASE_SERVICE_ROLE_KEY
# (below) on the server, and supabase/migrations/20261107000100_ai_usage.sql applied BEFORE you
# deploy. Without those, AI routes answer "not available".
ANTHROPIC_API_KEY=
# LARDER_AI_MODEL=claude-haiku-5-5
# Optional: AI calls per signed-in person per day (default 40).
# AI_DAILY_LIMIT=40

# Server only: TheMealDB supporter key for production (the shared test key "1" is used when empty)
THEMEALDB_API_KEY=

# Background reminders (Web Push). Generate a key pair with `npx web-push generate-vapid-keys`.
# The public key is safe in the browser; the private key is server only. Leave empty to
# keep reminders in-app only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services if something goes wrong: mailto:you@example.com or your site's URL.
VAPID_SUBJECT=
# Server only: checks sign-in and the daily allowance for AI features, lets the reminder sender
# read every household's food, and deletes accounts. Supabase dashboard →
# Project Settings → API keys → service_role (or a secret key). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: any long random string. The hourly Supabase pg_cron job sends it to /api/push/send
# (store it in Supabase Vault too; see README "Background reminders").
CRON_SECRET=
